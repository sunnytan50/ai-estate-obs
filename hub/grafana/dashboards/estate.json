{
  "id": null,
  "uid": "aiobs-estate",
  "title": "AI Estate",
  "description": "Flagship estate overview: GPU power/thermal and local inference throughput. Cloud-token rows land in a later revision of this file.",
  "tags": ["aiobs"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Power",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "GPU Power Now",
      "description": "Live nvidia-smi power draw, win5090.",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "watt",
          "min": 0,
          "max": 600,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 450 },
              { "color": "red", "value": 550 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vm" },
          "expr": "nvidia_smi_power_draw_watts",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Watts vs Tok/s (24h)",
      "description": "Power draw (left axis) overlaid with local server generation throughput (right axis). llama.cpp arm activates once that lane goes resident.",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "watt",
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "watts",
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "tok/s" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.axisLabel", "value": "tok/s" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vm" },
          "expr": "nvidia_smi_power_draw_watts",
          "legendFormat": "watts",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "vm" },
          "expr": "sum(rate(sglang:generation_tokens_total[1m])) or sum(rate(llamacpp_tokens_predicted_total[1m]))",
          "legendFormat": "tok/s",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Energy Today",
      "description": "Average power over the visible range, converted to kWh (avg_watts * range_seconds / 3600 / 1000).",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "kwatth",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vm" },
          "expr": "avg_over_time(nvidia_smi_power_draw_watts[$__range]) * $__range_s / 3600 / 1000",
          "legendFormat": "kWh",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "VRAM / Temp",
      "description": "GPU memory used (left axis, binary bytes) vs die temperature (right axis, deg C).",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes",
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "VRAM",
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "temp °C" },
            "properties": [
              { "id": "unit", "value": "celsius" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.axisLabel", "value": "temp" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vm" },
          "expr": "nvidia_smi_memory_used_bytes",
          "legendFormat": "VRAM used",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "vm" },
          "expr": "nvidia_smi_temperature_gpu",
          "legendFormat": "temp °C",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Local Inference",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Prompt vs Generation (by model)",
      "description": "Server-side sglang: token rates by model_name, stacked. llama.cpp arm activates once that lane goes resident.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vm" },
          "expr": "sum by (model_name)(rate(sglang:prompt_tokens_total[5m])) or sum by (model_name)(rate(llamacpp_prompt_tokens_total[5m]))",
          "legendFormat": "prompt {{model_name}}",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "vm" },
          "expr": "sum by (model_name)(rate(sglang:generation_tokens_total[5m])) or sum by (model_name)(rate(llamacpp_tokens_predicted_total[5m]))",
          "legendFormat": "generation {{model_name}}",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency (p50 / p95)",
      "description": "End-to-end request latency, sglang: histogram (verified live name/labels; llama.cpp lane not yet resident).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "vm" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s",
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "axisPlacement": "auto",
            "scaleDistribution": { "type": "linear" },
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "vm" },
          "expr": "histogram_quantile(0.5, sum by (le)(rate(sglang:e2e_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "vm" },
          "expr": "histogram_quantile(0.95, sum by (le)(rate(sglang:e2e_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ]
    }
  ]
}
